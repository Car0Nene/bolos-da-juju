{
  "name": "Bolos da Juju",
  "short_name": "Bolos da Juju",
  "description": "O controle simples do dinheiro, das vendas e das encomendas dos Bolos da Juju.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "lang": "pt-BR",
  "background_color": "#fdeef3",
  "theme_color": "#c2185b",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Fiz uma venda", "url": "./?go=sale", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Fiz uma compra", "url": "./?go=buy", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Encomendas", "url": "./?go=orders", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "file", "accept": ["image/*", "application/pdf"] }]
    }
  }
}
